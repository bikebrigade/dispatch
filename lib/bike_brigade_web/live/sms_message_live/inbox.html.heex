<div id="messaging-inbox" phx-hook="MessagingInbox">
  <.currently_viewing others_present={@others_present} />
  <h1 class="mb-4 text-2xl font-semibold text-gray-900">Messages</h1>
  <nav class="mb-5 flex border-b border-gray-200 sm:gap-8" aria-label="Messages">
    <.link
      :for={tab <- @tabs}
      id={"inbox-tab-#{tab.value}"}
      patch={
        inbox_path(assigns, %{
          "tab" => tab.value,
          "context" => nil,
          "rider" => nil,
          "search" => nil
        })
      }
      aria-current={if @tab == tab.value, do: "page"}
      class={[
        "flex flex-1 items-center justify-center gap-2 border-b-2 px-1 py-4 text-xs font-medium sm:flex-none sm:text-sm",
        if(@tab == tab.value,
          do: "border-indigo-500 text-indigo-600",
          else: "border-transparent text-gray-500 hover:text-gray-700"
        )
      ]}
    >
      <span class="sm:hidden">{if tab.value == "all", do: "All chats", else: tab.label}</span><span class="hidden sm:inline">{tab.label}</span>
      <span
        :if={tab.count}
        class="hidden rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-700 sm:inline"
      >
        {tab.count}
      </span>
    </.link>
  </nav>
  <div id="inbox-workspace" class="relative flex min-h-0 gap-4 h-[var(--inbox-workspace-height)]">
    <aside
      :if={@tab != "all"}
      id="inbox-contexts"
      class={[
        "w-full shrink-0 flex-col rounded-lg bg-white shadow min-h-0 lg:w-1/4 lg:min-w-[16rem] lg:flex",
        if(@params["context"] || @params["rider"], do: "hidden", else: "flex")
      ]}
    >
      <div class="shrink-0 border-b border-gray-200 p-4">
        <%= if @tab == "campaigns" do %>
          <h2 class="text-base font-semibold text-gray-900">Campaigns this week</h2>
          <p class="mt-1 text-xs text-gray-500">{@week_label}</p>
          <form id="inbox-filters" phx-change="filters" class="mt-4">
            <label class="inline-flex cursor-pointer items-center gap-2">
              <input type="hidden" name="mine" value="false" />
              <input
                id="inbox-mine"
                type="checkbox"
                role="switch"
                name="mine"
                value="true"
                checked={@mine}
                class="sr-only peer"
              />
              <span
                aria-hidden="true"
                class="inline-flex h-6 w-11 shrink-0 rounded-full border-2 border-transparent bg-gray-200 peer-checked:bg-indigo-600 peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-600"
              >
                <span class={[
                  "h-5 w-5 rounded-full bg-white shadow transition-transform",
                  if(@mine, do: "translate-x-5", else: "translate-x-0")
                ]} />
              </span>
              <span class="text-xs font-medium text-gray-900">Only my campaigns</span>
            </label>
          </form>
        <% else %>
          <h2 class="text-base font-semibold text-gray-900">Bulk messages</h2>
          <.button id="new-bulk" type="button" phx-click="bulk" size={:small} class="mt-3">
            <Heroicons.plus class="mr-2 h-4 w-4" />New bulk message
          </.button>
        <% end %>
      </div>
      <div class="min-h-0 flex-1 overflow-y-auto">
        <.link
          :for={context <- @contexts}
          patch={inbox_path(assigns, %{"context" => context.id, "rider" => nil, "search" => nil})}
          class={[
            "block border-b border-gray-200 p-4 hover:bg-gray-50",
            @context && @context.id == context.id && "bg-indigo-50"
          ]}
        >
          <p class="text-sm font-semibold text-indigo-600">{context.name}</p>
          <p class="mt-1 text-xs text-gray-500">{context.detail}</p>
          <p class="mt-2 text-xs text-gray-500">{length(context.ids)} riders</p>
        </.link>
        <p :if={@contexts == []} class="p-4 text-sm text-gray-500">
          {if @tab == "campaigns",
            do: "No campaigns match your filters.",
            else: "No saved bulk messages yet."}
        </p>
      </div>
    </aside>
    <.merged_inbox
      :if={@tab != "all"}
      uploads={if @modal, do: nil, else: @uploads}
      context={@context}
      rows={@rows}
      rider={@rider}
      tab={@tab}
      close={inbox_path(assigns, %{"rider" => nil})}
      search={@search}
      mobile_open={!!(@params["context"] || @params["rider"])}
      back_to_contexts={inbox_path(assigns, %{"context" => nil, "rider" => nil, "search" => nil})}
    >
      <:chat>
        <.live_component
          :if={@rider}
          module={ConversationComponent}
          id={@rider.id}
          rider={@rider}
          current_user={@current_user}
          live_action={:show}
          mobile_visible={true}
          show_tasks_link={false}
          back_patch={inbox_path(assigns, %{"rider" => nil})}
          unified_header={true}
        />
      </:chat>
    </.merged_inbox>
    <section
      :if={@tab == "all"}
      id="inbox-riders"
      class={[
        "w-full shrink-0 flex-col rounded-lg bg-white shadow min-h-0 lg:w-1/4 lg:min-w-[16rem] lg:flex",
        if(@params["rider"], do: "hidden", else: "flex")
      ]}
    >
      <div class="border-b border-gray-200 px-4 py-5">
        <h2 class="text-base font-semibold text-gray-900">All conversations</h2>
        <form phx-change="search" class="mt-3">
          <.input
            errors={[]}
            id="inbox-search"
            name="search"
            value={@search}
            placeholder="Search for Riders"
            phx-debounce="150"
          />
        </form>
      </div>
      <div class="min-h-0 flex-1 overflow-y-auto">
        <.sms_message_list
          initials_badges={true}
          conversations={@streams.conversations}
          rider_link_fn={fn id -> inbox_path(assigns, %{"rider" => id}) end}
        />
      </div>
    </section>
    <section
      :if={@tab == "all"}
      id="inbox-chat"
      class={[
        "min-h-0 min-w-0 flex-1 flex-col",
        if(@params["rider"], do: "flex", else: "hidden lg:flex")
      ]}
    >
      <.live_component
        :if={@rider}
        module={ConversationComponent}
        id={@rider.id}
        rider={@rider}
        current_user={@current_user}
        live_action={:show}
        mobile_visible={true}
        show_tasks_link={false}
        back_patch={inbox_path(assigns, %{"rider" => nil})}
        unified_header={true}
      />
      <p :if={!@rider} class="rounded-lg bg-white p-8 text-gray-500 shadow">
        No conversations yet.
      </p>
    </section>
    <div :if={@modal} id="new-bulk-drawer" class="absolute inset-0 z-30">
      <button
        type="button"
        aria-label="Close new bulk message"
        phx-click="close_bulk"
        class="absolute inset-0 w-full rounded-lg bg-gray-900/20"
      />
      <.focus_wrap
        id="new-bulk-container"
        phx-mounted={JS.focus_first(to: "#new-bulk-container")}
        phx-window-keydown={JS.push("close_bulk")}
        phx-key="Escape"
        role="dialog"
        aria-modal="true"
        aria-labelledby="new-bulk-title"
        class="absolute inset-y-0 right-0 w-full overflow-y-auto rounded-lg border border-gray-200 bg-white p-5 shadow-xl md:w-2/3"
      >
        <div class="mb-5 flex items-center gap-3">
          <button
            type="button"
            phx-click="close_bulk"
            aria-label="Back to bulk messages"
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-indigo-600 hover:bg-indigo-50"
          >
            <Heroicons.chevron_left class="h-6 w-6" />
          </button>
          <div>
            <h2 id="new-bulk-title" class="text-lg font-semibold text-gray-900">
              New bulk message
            </h2>
            <p class="mt-1 text-sm text-gray-500">Each rider receives an individual message.</p>
          </div>
        </div>
        <.form
          for={@bulk_form}
          id="inbox-bulk-form"
          phx-change="validate_bulk"
          phx-submit="send_bulk"
        >
          <.input
            errors={[]}
            field={@bulk_form[:body]}
            type="textarea"
            label="Message"
            required={@uploads.media.entries == []}
            maxlength="1600"
          />
          <div class="mt-3">
            <.live_file_input upload={@uploads.media} class="text-sm text-gray-600" />
            <div
              :for={entry <- @uploads.media.entries}
              class="mt-2 flex items-center gap-2 text-sm text-gray-500"
            >
              {entry.client_name}
              <button
                type="button"
                phx-click="cancel_upload"
                phx-value-ref={entry.ref}
                aria-label={"Remove #{entry.client_name}"}
              >
                Remove
              </button>
            </div>
          </div>
          <div class="mt-4">
            <.rider_select
              id="inbox-rider-select"
              name="recipients[]"
              multi={true}
              selected_riders={Riders.get_riders(@bulk_ids)}
              notify_change={true}
              label="To"
            />
          </div>
          <label class="mt-4 inline-flex cursor-pointer items-center gap-3">
            <input type="hidden" name="save_group" value="false" /><input
              type="checkbox"
              name="save_group"
              value="true"
              checked={@save_group}
              role="switch"
              class="sr-only peer"
            />
            <span
              aria-hidden="true"
              class="inline-flex h-6 w-11 shrink-0 rounded-full border-2 border-transparent bg-gray-200 peer-checked:bg-indigo-600 peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-600"
            >
              <span class={[
                "h-5 w-5 rounded-full bg-white shadow transition-transform",
                if(@save_group, do: "translate-x-5", else: "translate-x-0")
              ]} />
            </span>
            Save this group <span class="text-xs text-gray-500">Optional</span>
          </label>
          <.input
            :if={@save_group}
            errors={[]}
            field={@bulk_form[:name]}
            label="Group name"
            required
            maxlength="100"
          />
          <p :if={@error} role="alert" class="mt-3 text-sm text-red-600">{@error}</p>
          <p
            :if={BikeBrigade.SmsService.sending_confirmation_message()}
            class="mt-3 text-sm text-amber-700"
          >
            {BikeBrigade.SmsService.sending_confirmation_message()}
          </p>
          <div class="mt-5 flex justify-end gap-3">
            <.button type="button" color={:white} phx-click="close_bulk">Cancel</.button><.button
              type="submit"
              phx-disable-with="Sending…"
            >Send</.button>
          </div>
        </.form>
      </.focus_wrap>
    </div>
  </div>
</div>
