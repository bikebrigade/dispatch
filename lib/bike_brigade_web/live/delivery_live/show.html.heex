<div class="mx-auto max-w-7xl sm:px-6 lg:px-8">
  <div
    class="overflow-hidden bg-white divide-y divide-gray-200 shadow-md sm:mt-2 sm:rounded-lg"
    role="banner"
  >
    <div class="p-2.5 sm:p-4 flex flex-wrap items-start justify-between sm:flex-nowrap">
      <div class="mb-2 ml-3" role="heading" aria-level="1">
        <h1 class="text-lg font-medium leading-6 text-gray-900">
          {campaign_name(@campaign)}
        </h1>
        <p class="mt-1 text-sm text-gray-500">
          {@rider.name}
        </p>
        <p class="mt-1 text-sm text-gray-500">
          {Calendar.strftime(@campaign_date, "%A, %b %d")}
        </p>

        <.link
          patch={~p"/itinerary"}
          aria-label="Go to ride itinerary"
          class="mt-1 text-sm text-indigo-600"
        >
          View all rides on your itinerary →
        </.link>
      </div>
      <div class="shrink-0">
        <div class="flex justify-end flex-1">
          <.button href={{:sms, "#{BikeBrigade.Messaging.inbound_number(@rider)}"}}>
            Contact Bike Brigade
          </.button>
        </div>
      </div>
    </div>
    <div class="shadow-inner bg-gray-50">
      <div class="px-3 py-2 pl-6 sm:py-3 sm:grid sm:grid-cols-8 sm:gap-2">
        <div class="text-sm font-semibold text-gray-800">
          Resources
        </div>
        <div class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-7">
          <div class="flex flex-col sm:flex-row sm:divide-gray-300 sm:divide-x-2">
            <a
              class="text-indigo-600 sm:pr-2 hover:text-indigo-900"
              href="https://www.bikebrigade.ca/safety"
            >
              Health and Safety
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="relative my-1 sm:my-2">
    <div class="absolute inset-0 flex items-center" aria-hidden="true">
      <div class="w-full border-t border-gray-300"></div>
    </div>
    <div class="relative flex justify-center">
      <span class="px-2 text-gray-500 bg-gray-50">
        <Heroicons.star class="w-5 h-5 text-gray-500" />
      </span>
    </div>
  </div>
  <div role="main">
    <div class="w-full overflow-hidden bg-white shadow-md sm:mt-2 sm:rounded-lg">
      <div
        class="flex items-start space-x-1 p-2.5 bg-white border-b border-gray-200 sm:p-4"
        aria-hidden="true"
      >
        <div class="flex items-center justify-center shrink-0 w-8 h-8 bg-green-700 rounded-full ring-8 ring-white">
          <Heroicons.clipboard_document_check mini class="w-5 h-5 text-white" />
        </div>
        <div class="w-full pl-1 border-l border-gray-200 sm:flex-nowrap">
          <div class="flex flex-col space-y-.5">
            <div class="flex flex-row items-center justify-between">
              <h2 class="mr-1 text-base font-semibold text-gray-900">
                Pick up
              </h2>
              <div class="flex flex-wrap items-start justify-end shrink ml-auto">
                <.button
                  href={open_map_url(@campaign)}
                  aria-label="Map Pickup"
                  size={:small}
                  color={:green}
                >
                  <Heroicons.map mini class="w-5 h-5 mr-1 -ml-0.5" /> Map
                </.button>
              </div>
            </div>
            <div class="inline-flex shrink-0 leading-normal">
              <Heroicons.clock
                mini
                aria-label="Pickup Time"
                class="w-4 h-4 mt-1 mr-1 text-gray-500"
              />
              {CampaignHelpers.pickup_window(@campaign, @rider)}
            </div>
            <.location location={@campaign.location} />
            <div class="inline-flex leading-normal">
              <Heroicons.shopping_bag mini class="shrink-0 w-4 h-4 mt-1 mr-1 text-gray-500 " />
              {humanized_task_count(@rider.assigned_tasks)}
            </div>
          </div>
        </div>
      </div>
      <dl class="sm:divide-y sm:divide-gray-200">
        <div class="px-6 py-2 pl-14 sm:py-5 sm:grid sm:grid-cols-8 sm:gap-2">
          <dt class="text-sm font-medium text-gray-500">
            Details
          </dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-7">
            <.collapsible id="campaign_details" class="whitespace-pre-wrap">
              {render_raw(@campaign.details)}
            </.collapsible>
          </dd>
        </div>
      </dl>
    </div>
    <%= for {task, i} <- Enum.with_index(@rider.assigned_tasks, 1) do %>
      <div class="relative my-1 sm:my-2">
        <div class="absolute inset-0 flex items-center" aria-hidden="true">
          <div class="w-full border-t border-gray-300"></div>
        </div>
        <div class="relative flex justify-center">
          <span class="px-2 text-gray-500 bg-gray-50">
            <Heroicons.chevron_down class="w-5 h-5 text-gray-500" />
          </span>
        </div>
      </div>
      <div class="w-full overflow-hidden bg-white shadow-md sm:mt-2 sm:rounded-lg">
        <div class="flex items-start space-x-1 p-2.5 bg-white border-b border-gray-200 sm:p-4">
          <div
            class="flex items-center justify-center shrink-0 w-8 h-8 bg-indigo-700 rounded-full ring-8 ring-white"
            aria-label={"Delivery #{i}"}
          >
            <span class="font-black text-white tabular-nums ">
              {i}
            </span>
          </div>
          <div class="w-full px-1 border-l border-gray-200">
            <div class="flex flex-col space-y-.5">
              <div class="flex flex-row items-center justify-between">
                <h2 class="mr-1 text-base font-semibold text-gray-900">
                  Delivery
                </h2>
                <div class="flex items-start justify-end shrink space-x-1">
                  <%= if task.dropoff_phone do %>
                    <.button
                      href={sms_url(@campaign, @rider, task)}
                      aria-label={"Text Delivery #{i}"}
                      size={:small}
                    >
                      <Heroicons.chat_bubble_bottom_center_text mini class="w-5 h-5 mr-1 -ml-0.5" />
                      Text
                    </.button>
                    <.button href={tel_url(task)} aria-label={"Call Delivery #{i}"} size={:small}>
                      <Heroicons.phone_arrow_up_right mini class="w-5 h-5 mr-1 -ml-0.5" /> Call
                    </.button>
                  <% end %>
                  <.button
                    href={open_map_url(task)}
                    target="_blank"
                    aria-label={"Map Delivery #{i}"}
                    size={:small}
                  >
                    <Heroicons.map mini class="w-5 h-5 mr-1 -ml-0.5" /> Map
                  </.button>
                </div>
              </div>
              <div class="inline-flex shrink-0 leading-normal">
                <Heroicons.user
                  mini
                  aria-label="Dropoff Name"
                  class="w-4 h-4 mt-1 mr-1 text-gray-500"
                />
                {task.dropoff_name}
              </div>
              <.location location={task.dropoff_location} />
              <div class="inline-flex shrink-0 leading-normal">
                <Heroicons.device_phone_mobile
                  mini
                  aria-label="Dropoff Phone"
                  class="w-4 h-4 mt-1 mr-1 text-gray-500"
                />
                <%= if !is_nil(task.dropoff_phone) do %>
                  {task.dropoff_phone}
                <% else %>
                  No phone number
                <% end %>
              </div>
              <div class="inline-flex leading-normal">
                <Heroicons.shopping_bag
                  mini
                  class="shrink-0 w-4 h-4 mt-1 mr-1 text-gray-500 "
                />
                {CampaignHelpers.request_type(task)}
              </div>
            </div>
          </div>
        </div>
        <dl class="sm:divide-y sm:divide-gray-200">
          <div
            :if={!is_nil(task.delivery_instructions) and task.delivery_instructions != ""}
            class="px-6 py-2 pl-14 sm:py-5 sm:grid sm:grid-cols-8 sm:gap-2"
          >
            <dt class="text-sm font-medium text-gray-500">
              Notes
            </dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-7">
              <.collapsible id={"delivery_details:#{i}"} max_height="max-h-24">
                {render_raw(task.delivery_instructions)}
              </.collapsible>
            </dd>
          </div>
          <div class="px-6 py-2 pl-14 sm:py-5">
            <div class="flex flex-row items-center justify-start gap-2">
              <div
                :if={task.delivery_status == :completed}
                class="inline-flex items-center px-3 py-2 text-sm font-medium text-green-700 bg-green-50 rounded-sm"
              >
                <Heroicons.check_circle mini class="w-5 h-5 mr-1 -ml-0.5" /> Completed
              </div>
              <.button
                :if={task.delivery_status in [:pending, :picked_up]}
                phx-click="mark_complete"
                phx-value-task-id={task.id}
                size={:small}
                color={:green}
              >
                <Heroicons.check_circle mini class="w-5 h-5 mr-1 -ml-0.5" /> Mark Complete
              </.button>
              <.button
                phx-click="toggle_note_form"
                phx-value-task-id={task.id}
                size={:small}
                color={:secondary}
              >
                <Heroicons.pencil_square mini class="w-5 h-5 mr-1 -ml-0.5" /> Add a note
              </.button>
            </div>
            <%= if @active_note_task_id == task.id do %>
              <div class="mt-3">
                <form phx-submit="submit_note">
                  <input type="hidden" name="task_id" value={task.id} />
                  <div class="space-y-3">
                    <div>
                      <label
                        for={"note_#{task.id}"}
                        class="block text-sm font-medium text-gray-700"
                      >
                        Note
                      </label>
                      <textarea
                        id={"note_#{task.id}"}
                        name="note"
                        rows="3"
                        class="block w-full mt-1 border-gray-300 rounded-md shadow-xs focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                        placeholder="Enter your note here..."
                        phx-change="update_note"
                      >{@note_text}</textarea>
                    </div>
                    <div class="flex justify-end space-x-2">
                      <button
                        type="button"
                        phx-click="toggle_note_form"
                        phx-value-task-id={task.id}
                        class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md shadow-xs hover:bg-gray-50 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
                      >
                        Cancel
                      </button>
                      <button
                        type="submit"
                        class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-indigo-600 border border-transparent rounded-md shadow-xs hover:bg-indigo-700 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
                      >
                        Submit Note
                      </button>
                    </div>
                  </div>
                </form>
              </div>
            <% end %>
          </div>
        </dl>
      </div>
    <% end %>
    <div :if={@rider.assigned_tasks != []} class="relative my-1 sm:my-2">
      <div class="absolute inset-0 flex items-center" aria-hidden="true">
        <div class="w-full border-t border-gray-300"></div>
      </div>
      <div class="relative flex justify-center">
        <span class="px-2 text-gray-500 bg-gray-50">
          <Heroicons.chevron_double_down class="w-5 h-5 text-gray-500" />
        </span>
      </div>
    </div>
    <div
      :if={@rider.assigned_tasks != []}
      class="w-full overflow-hidden bg-white shadow-md sm:mt-2 sm:rounded-lg"
    >
      <div class="flex items-start space-x-1 p-2.5 bg-white border-b border-gray-200 sm:p-4">
        <div class="flex items-center justify-center shrink-0 w-8 h-8 bg-green-700 rounded-full ring-8 ring-white">
          <Heroicons.star mini class="w-5 h-5 text-white" />
        </div>
        <div class="w-full pl-1 border-l border-gray-200 sm:flex-nowrap">
          <div class="flex flex-row items-center justify-between">
            <h2 class="mr-1 text-base font-semibold text-gray-900">
              Tell us you're done.
            </h2>
            <div class="flex flex-wrap items-start justify-end shrink ml-auto">
              <.button
                id="complete-delivery"
                type="button"
                phx-click="complete_delivery"
                phx-disable-with="Completing…"
                disabled={Enum.all?(@rider.assigned_tasks, &(&1.delivery_status == :completed))}
                class="ml-auto"
                color={:green}
              >
                <Heroicons.check_circle mini class="w-5 h-5 mr-1 -ml-0.5" />
                <%= if Enum.all?(@rider.assigned_tasks, &(&1.delivery_status == :completed)) do %>
                  Completed
                <% else %>
                  I'm done!
                <% end %>
              </.button>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div :if={@rider.assigned_tasks != []} class="relative my-1 sm:my-2">
      <div class="absolute inset-0 flex items-center" aria-hidden="true">
        <div class="w-full border-t border-gray-300"></div>
      </div>
      <div class="relative flex justify-center">
        <span class="px-2 text-gray-500 bg-gray-50">
          <Heroicons.map mini class="w-5 h-5 text-gray-500" />
        </span>
      </div>
    </div>
    <div
      :if={@rider.assigned_tasks != []}
      class="overflow-hidden bg-white border-t divide-y divide-gray-200 shadow-md sm:mt-2 sm:rounded-lg"
    >
      <div class="flex flex-row items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900 ml-7">
          Full Route Map
        </h2>
        <div class="flex justify-end flex-1 pb-1 my-4 mr-3">
          <.button href={directions_url(assigns)} class="font-medium text-white">
            Open in Google Maps
          </.button>
        </div>
      </div>
      <div class="p-3 sm:p-4">
        <div class="w-full h-80">
          <iframe
            width="100%"
            height="100%"
            frameborder="0"
            style="border:0"
            src={embed_directions_url(assigns)}
            allowfullscreen
          ></iframe>
        </div>
        <br />
      </div>
    </div>
    <section id="delivery-selfie" class="card bg-base-100 text-base-content shadow-md my-4">
      <div class="card-body p-4 sm:p-6">
        <h2 class="card-title">Share a delivery selfie</h2>
        <p class="text-sm text-base-content/70">
          Snap a selfie on your ride and share it with Bike Brigade.
        </p>
        <form
          id="selfie-form"
          phx-change="validate_selfie"
          phx-submit="upload_selfie"
          class="flex flex-col gap-3"
        >
          <label
            for={@uploads.selfie.ref}
            class="btn btn-primary self-start gap-2 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary"
          >
            <Heroicons.camera class="h-5 w-5" aria-hidden="true" /> Take a selfie
            <.live_file_input
              upload={@uploads.selfie}
              capture="user"
              class="sr-only"
              aria-describedby="selfie-help"
            />
          </label>
          <p id="selfie-help" class="text-sm text-base-content/70">One photo, up to 20 MB.</p>
          <p :for={error <- upload_errors(@uploads.selfie)} class="alert alert-error" role="alert">
            {selfie_upload_error(error)}
          </p>
          <div :for={entry <- @uploads.selfie.entries} class="flex flex-col gap-2">
            <.live_img_preview
              :if={entry.client_type in ["image/jpeg", "image/png", "image/webp"]}
              entry={entry}
              class="max-h-64 w-full object-contain rounded-lg"
            />
            <span class="text-sm break-all">{entry.client_name}</span>
            <progress
              class="progress progress-primary w-full"
              value={entry.progress}
              max="100"
              aria-label="Photo upload progress"
            >{entry.progress}%</progress>
            <p
              :for={error <- upload_errors(@uploads.selfie, entry)}
              class="alert alert-error"
              role="alert"
            >
              {selfie_upload_error(error)}
            </p>
            <button
              type="button"
              phx-click="cancel_selfie"
              phx-value-ref={entry.ref}
              class="btn btn-ghost btn-sm self-start"
            >Remove photo</button>
          </div>
          <p :if={@selfie_error} class="alert alert-error" role="alert">{@selfie_error}</p>
          <button
            type="submit"
            phx-disable-with="Uploading…"
            disabled={
              @uploads.selfie.entries == [] or
                Enum.any?(@uploads.selfie.entries, &(!&1.done? or !&1.valid?))
            }
            class="btn btn-primary self-start"
          >
            Upload selfie
          </button>
        </form>
      </div>
    </section>
    <div
      :if={@backup_rider && @rider.assigned_tasks == []}
      id="backup-rider-empty-state"
      class="p-4 text-center bg-white shadow-md sm:mt-2 sm:rounded-lg"
    >
      Thank you for signing up as a backup rider.
    </div>
  </div>
</div>
